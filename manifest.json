{
  "manifest_version": 2,
  "name": "Owlbear Rodeo RPG Rank Sheet",
  "version": "1.0.0",
  "description": "Compact character sheet for custom TTRPG with rank dice and parameter checks.",
  "icon": {
    "128": "icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
  },
  "browser_action": {
    "default_popup": "index.html"
  },
  "web_accessible_resources": [
    "index.html",
    "script.js",
    "style.css"
  ]
}
